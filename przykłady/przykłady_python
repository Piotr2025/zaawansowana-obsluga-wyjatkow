"""
PRZYKŁAD: Podstawowa obsługa wyjątków przy użyciu try...except
Temat: Blokowanie crashu programu przy dzieleniu przez zero.
"""

print("--- START PRZYKŁADU ---")

try:
    # Python próbuje wykonać poniższe działanie matematyczne
    wynik = 10 / 0
    print(f"Wynik to: {wynik}")
    
except ZeroDivisionError:
    # Jeśli w bloku 'try' pojawi się błąd ZeroDivisionError,
    # Python nie wyłączy programu, tylko przejdzie tutaj:
    print("[INFO] Komunikat z sekcji except: Nie można dzielić przez zero!")

print("--- KONIEC PRZYKŁADU (Program nie scrashował i działa do końca) ---")


"""
Przykład
"""

try:
    liczba = int(input("Podaj liczbę, przez którą mam podzielić 100: "))
    wynik = 100 / liczba
    print(f"Wynik to: {wynik}")

except ValueError:
    print("Błąd: Musisz podać liczbę całkowitą, a nie tekst!")

except ZeroDivisionError:
    print("Błąd: Nie można dzielić przez zero!")

except Exception as e:
    print(f"Wystąpił inny, nieznany błąd: {e}")


Przykład

try:
    # Tutaj wpisujesz kod, który MOŻE wygenerować błąd
    liczba = int(input("Podaj liczbę: "))
    wynik = 10 / liczba
    print(f"Wynik 10 podzielone przez {liczba} to: {wynik}")

except ZeroDivisionError:
    # Ten kod wykona się TYLKO, jeśli użytkownik wpisze 0
    print("Ej, nie można dzielić przez zero!")

except ValueError:
    # Ten kod wykona się, jeśli użytkownik wpisze np. "XYZ" zamiast liczby
    print("To nie jest poprawna liczba!")


